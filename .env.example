# Telegram Bot API
TELEGRAM_BOT_TOKEN=
# IDs separados por vírgula. Em produção, configure pelo menos um.
TELEGRAM_ALLOWED_CHAT_IDS=

# Catálogo Crunchyroll: forneça um access token obtido por um fluxo autorizado.
# O bot NÃO coleta senha via chat e NÃO armazena credenciais de conta.
CRUNCHYROLL_ACCESS_TOKEN=
CRUNCHYROLL_API_BASE=https://beta-api.crunchyroll.com
CRUNCHYROLL_LOCALE=pt-BR
CRUNCHYROLL_USER_AGENT=CrunchrollBot/0.2

# Bot
BOT_POLL_TIMEOUT_SECONDS=25
BOT_MAX_CONCURRENT_JOBS=2
BOT_DATA_DIR=.data
